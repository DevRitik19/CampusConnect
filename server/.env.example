# ==============================================================
# CampusConnect Backend Environment Configuration Example
# ==============================================================

# Server configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
# Example: mongodb://localhost:27017/campusconnect or MongoDB Atlas SRV URI
MONGODB_URI=mongodb://localhost:27017/campusconnect

# Authentication / JWT
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d
COOKIE_NAME=campusconnect_token

# Client URL (Allowed CORS Origin)
CLIENT_URL=http://localhost:5173

# College / Campus Specific Configuration
COLLEGE_NAME="Scaler School of Technology"
COLLEGE_EMAIL_DOMAIN=all

# Optional Cloudinary Configuration (for persistent image uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Optional Email Service (if verification emails are active)
EMAIL_FROM=noreply@campusconnect.local
