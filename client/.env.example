# Backend API Base URL
# - In local development: http://localhost:5000/api (or leave empty to rely on Vite proxy /api)
# - In production (Vercel/Netlify): https://<your-backend-service>.onrender.com/api
VITE_API_URL=http://localhost:5000/api
