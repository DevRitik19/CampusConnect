# ==============================================================
# CampusConnect Environment Configuration Example
# ==============================================================

# Server configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
# Example: mongodb://localhost:27017/campusconnect or MongoDB Atlas SRV URI
MONGODB_URI=mongodb://localhost:27017/campusconnect

# Authentication / JWT
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d
COOKIE_NAME=campusconnect_token

# Client URL (Allowed CORS Origin)
CLIENT_URL=http://localhost:5173

# College / Campus Specific Configuration
# Set to your institution's official email domain (e.g., yourcollege.com, scaler.com, college.ac.in).
# In production, this MUST be configured with your institution's domain and cannot be 'all' or '*'.
# In local development only, you may set to 'all' or '*' to test with arbitrary email addresses.
COLLEGE_NAME="Scaler School of Technology"
COLLEGE_EMAIL_DOMAIN=yourcollege.com

# Optional Cloudinary Configuration (for persistent image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional Email Service (if verification emails are active)
EMAIL_FROM=noreply@campusconnect.local
